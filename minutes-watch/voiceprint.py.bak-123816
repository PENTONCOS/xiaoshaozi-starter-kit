#!/usr/bin/env python3
"""声纹识别标记：把 diarization 的 S0/S1 映射到真人。

三个子命令：
  build-samples <audio> --diar d.json --out DIR
      按说话人裁剪试听片段（每人 ~45s 连续语音）+ 提取声纹向量，供人工确认身份
  enroll <name> --from-samples DIR|--audio FILE [--label S0]
      把确认后的声纹登记进声纹库 ~/.openclaw/minutes-watch/voices/
  identify <audio> --diar d.json
      用声纹库给 S0/S1 打真人名字（余弦相似度，阈值 0.55）

设计原则：
  - 声纹是生物特征，只存向量不存原始音频；库目录 700，文件 600
  - 匹配相似度低于阈值时保持 S0/S1，不猜名字
"""
import argparse, json, os, subprocess, sys, wave
import numpy as np

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import importlib.util
_spec = importlib.util.spec_from_file_location("diar", os.path.join(os.path.dirname(os.path.abspath(__file__)), "diarize.py"))
diar = importlib.util.module_from_spec(_spec); _spec.loader.exec_module(diar)

VOICE_DIR = os.path.expanduser("~/.openclaw/minutes-watch/voices")
SR = 16000
MATCH_THRESHOLD = 0.55


def load_wav(path):
    wav = diar.ensure_wav16k(path)
    with wave.open(wav, "rb") as w:
        n = w.getnframes()
        data = np.frombuffer(w.readframes(n), dtype=np.int16).astype(np.float32) / 32768.0
    return data


def slice_wav(samples, sr, start, end):
    a, b = int(start * sr), int(end * sr)
    return samples[max(0, a):min(len(samples), b)]


def write_wav(path, samples, sr=SR):
    pcm = np.clip(samples, -1, 1)
    with wave.open(path, "wb") as w:
        w.setnchannels(1); w.setsampwidth(2); w.setframerate(sr)
        w.writeframes((pcm * 32767).astype(np.int16).tobytes())


def cos(a, b):
    a = a / (np.linalg.norm(a) + 1e-9)
    b = b / (np.linalg.norm(b) + 1e-9)
    return float(a @ b)


def cmd_build_samples(a):
    samples = load_wav(a.audio)
    sr = SR
    with open(a.diar, encoding="utf8") as f:
        d = json.load(f)
    segs = d.get("segments") or []
    if not segs:
        sys.exit("diar.json 里没有 segments")
    dur_total = len(samples) / sr
    os.makedirs(a.out, exist_ok=True)

    by = {}
    for s in segs:
        by.setdefault(s["speaker"], []).append(s)

    manifest = {"audio": os.path.abspath(a.audio), "diar": os.path.abspath(a.diar),
                "duration": round(dur_total, 2), "speakers": []}

    for spk in sorted(by):
        ss = sorted(by[spk], key=lambda s: s["start"])
        # 挑最长的若干段凑够目标时长（保留时间顺序）
        picked, acc = [], 0.0
        for s in sorted(ss, key=lambda s: s["end"] - s["start"], reverse=True):
            if acc >= a.seconds:
                break
            if s["end"] - s["start"] < 0.8:
                continue
            picked.append(s); acc += s["end"] - s["start"]
        picked.sort(key=lambda s: s["start"])

        chunks = []
        for i, s in enumerate(picked):
            if i:
                chunks.append(np.zeros(int(0.35 * sr), dtype=np.float32))
            chunks.append(slice_wav(samples, sr, s["start"], s["end"]))
        clip = np.concatenate(chunks) if chunks else np.zeros(sr, dtype=np.float32)

        wav_path = os.path.join(a.out, f"{spk}.wav")
        write_wav(wav_path, clip)
        m4a_path = os.path.join(a.out, f"{spk}.m4a")
        subprocess.run(["afconvert", "-f", "m4af", "-d", "aac", "-b", "64000", wav_path, m4a_path],
                       check=False, capture_output=True)

        # 声纹：必须与 identify 一致 —— 用该簇全部段的 embedding 平均。
        # 2026-10-27 修正：原先用「最长若干段」子集，同一簇算出与元化 0.6823，
        # 而 identify 全段平均是 0.4847，差 0.2。挑段法受个别混音段影响太大，不可用于入库。
        # picked 仅用于生成试听音频，不参与声纹。
        E, idx = diar.embed_segments(samples, [{"start": s["start"], "end": s["end"]} for s in ss])
        if len(E) == 0:
            print(f"  {spk}: 声纹提取失败（片段太短）", flush=True)
            emb = None
        else:
            emb = E.mean(axis=0)
            emb = emb / (np.linalg.norm(emb) + 1e-9)
        if emb is not None:
            np.save(os.path.join(a.out, f"{spk}.npy"), emb.astype(np.float32))

        total_speech = sum(s["end"] - s["start"] for s in ss)
        manifest["speakers"].append({
            "label": spk,
            "segments": len(ss),
            "speechSec": round(total_speech, 1),
            "share": round(total_speech / max(dur_total, 1e-9), 3),
            "sampleSec": round(len(clip) / sr, 1),
            "sample": f"{spk}.m4a",
            "embedding": f"{spk}.npy" if emb is not None else None,
        })
        print(f"  {spk}: {len(ss)} 段 / 语音 {total_speech:.0f}s / 占比 {total_speech/dur_total:.1%} / 试听 {len(clip)/sr:.1f}s", flush=True)

    with open(os.path.join(a.out, "manifest.json"), "w", encoding="utf8") as f:
        json.dump(manifest, f, ensure_ascii=False, indent=2)
    print(json.dumps(manifest, ensure_ascii=False, indent=2))


def cmd_enroll(a):
    os.makedirs(VOICE_DIR, exist_ok=True)
    os.chmod(VOICE_DIR, 0o700)
    if a.from_samples:
        src = os.path.join(a.from_samples, f"{a.label}.npy")
        if not os.path.exists(src):
            sys.exit(f"找不到 {src}")
        emb = np.load(src)
    else:
        samples = load_wav(a.audio)
        segs = [{"start": 0.0, "end": len(samples) / SR}]
        E, idx = diar.embed_segments(samples, segs)
        if len(E) == 0:
            sys.exit("参考音频里没提取到有效声纹（太短或全是静音）")
        emb = E.mean(axis=0)
    emb = emb / (np.linalg.norm(emb) + 1e-9)

    # 每个来源单独存一个向量，避免跨场互相污染
    source = a.source or "manual"
    safe_src = "".join(c if c.isalnum() or c in "-_." else "_" for c in source)[:60]
    fname = f"{a.name}__{safe_src}.npy"
    path = os.path.join(VOICE_DIR, fname)
    np.save(path, emb.astype(np.float32))
    os.chmod(path, 0o600)

    gpath = os.path.join(VOICE_DIR, "gallery.json")
    gal = json.load(open(gpath, encoding="utf8")) if os.path.exists(gpath) else {}
    ent = gal.get(a.name) or {}
    vecs = ent.get("vectors")
    if vecs is None:                      # 兼容旧格式（单个 file）
        vecs = []
        if ent.get("file"):
            vecs.append({"file": ent["file"], "source": "legacy",
                         "dim": ent.get("dim", int(emb.shape[0])),
                         "enrolledAt": ent.get("enrolledAt", "")})
    vecs = [v for v in vecs if v.get("file") != fname]
    vecs.append({"file": fname, "source": source, "dim": int(emb.shape[0]),
                 "enrolledAt": __import__("datetime").datetime.now().astimezone().isoformat(timespec="seconds")})
    gal[a.name] = {"dim": int(emb.shape[0]), "vectors": vecs}
    json.dump(gal, open(gpath, "w", encoding="utf8"), ensure_ascii=False, indent=2)
    os.chmod(gpath, 0o600)
    print(f"已登记声纹: {a.name} 来源 {source} -> {path}（该人共 {len(vecs)} 个来源向量）")


def cmd_identify(a):
    gpath = os.path.join(VOICE_DIR, "gallery.json")
    if not os.path.exists(gpath):
        sys.exit(f"声纹库为空：{VOICE_DIR}/gallery.json 不存在，先 enroll")
    gal = json.load(open(gpath, encoding="utf8"))
    names = {}
    for k, v in gal.items():
        if v.get("disabled"):
            print(f"[identify] 跳过已停用声纹: {k}（{v.get('disabledReason','')}）", file=sys.stderr)
            continue
        files = [x["file"] for x in v["vectors"]] if v.get("vectors") else ([v["file"]] if v.get("file") else [])
        mats = [np.load(os.path.join(VOICE_DIR, f)) for f in files if os.path.exists(os.path.join(VOICE_DIR, f))]
        if not mats:
            continue
        m = np.mean(mats, axis=0)
        names[k] = m / (np.linalg.norm(m) + 1e-9)
    if not names:
        sys.exit("声纹库里没有可用的向量文件")

    samples = load_wav(a.audio)
    d = json.load(open(a.diar, encoding="utf8"))
    by = {}
    for s in d.get("segments") or []:
        by.setdefault(s["speaker"], []).append(s)

    # 人工标注的多人群：直接跳过，不输出任何名字（避免混音被误判成其中某人）
    skip = set(x.strip() for x in (a.skip or "").split(",") if x.strip())
    mapfile = os.path.join(os.path.dirname(os.path.abspath(a.diar)), "speaker-map.json")
    if os.path.exists(mapfile) and not a.no_map:
        try:
            mm = json.load(open(mapfile, encoding="utf8"))
            for k, v in (mm.get("labels") or {}).items():
                if v.get("mixed"):
                    skip.add(k)
        except Exception:
            pass

    result = {}
    for spk, ss in sorted(by.items()):
        if spk in skip:
            result[spk] = {"name": None, "skipped": "mixed-cluster", "reason": "人工标注为多人混合，跳过声纹匹配"}
            continue
        E, _ = diar.embed_segments(samples, [{"start": s["start"], "end": s["end"]} for s in ss])
        if len(E) == 0:
            result[spk] = {"name": None, "reason": "no embedding"}
            continue
        emb = E.mean(axis=0)
        scores = {n: cos(emb, g) for n, g in names.items()}
        ranked = sorted(scores.items(), key=lambda x: -x[1]) if scores else []
        best = ranked[0][0] if ranked else None
        ok = best and scores[best] >= a.threshold
        # 2026-10-27 教训：混合簇会把两个人的平均向量顶到第三个人身上（本场 S1 对婉辞 0.7023 属误判）。
        # 前两名都过阈值 => 判为混合/歧义，不出名字。
        second = ranked[1] if len(ranked) > 1 else None
        # 2026-10-27：同场不同人相似度可达 0.58–0.75（出九 0.7473 vs 元化 0.7064），
        # 光看阈值分不开。再加一道「第一名必须领先第二名 margin」才具名。
        margin = (ranked[0][1] - ranked[1][1]) if len(ranked) > 1 else 1.0
        thin = bool(ok and margin < a.margin and not a.allow_ambiguous)
        ambig = bool(ok and second and second[1] >= a.threshold and not a.allow_ambiguous)
        result[spk] = {"name": None if (ambig or thin) else (best if ok else None),
                       "score": round(scores[best], 4) if best else None,
                       "threshold": a.threshold,
                       "margin": round(margin, 4),
                       "suspect": "two-above-threshold" if ambig else ("margin-too-small" if thin else None),
                       "reason": (f"前两名均过阈值（{best} {scores[best]:.4f} / {second[0]} {second[1]:.4f}），判为混合簇或歧义，不出名字" if ambig
                                  else (f"第一名领先不足 {a.margin}（{best} {scores[best]:.4f} vs {second[0]} {second[1]:.4f}，差 {margin:.4f}），不出名字" if thin else None)),
                       "all": {k: round(v, 4) for k, v in ranked}}
    print(json.dumps(result, ensure_ascii=False, indent=2))
    named = {k: v["name"] for k, v in result.items() if v.get("name")}
    skipped = [k for k, v in result.items() if v.get("skipped")]
    print(f"\n[identify] 识别 {len(named)} 人 {named}，跳过 {len(skipped)} 个混合簇 {skipped}", file=sys.stderr)


ap = argparse.ArgumentParser()
sub = ap.add_subparsers(dest="cmd", required=True)

p = sub.add_parser("build-samples", help="按说话人裁试听片段 + 存声纹")
p.add_argument("audio"); p.add_argument("--diar", required=True); p.add_argument("--out", required=True)
p.add_argument("--seconds", type=float, default=45)
p.set_defaults(fn=cmd_build_samples)

p = sub.add_parser("enroll", help="登记某人声纹")
p.add_argument("name"); p.add_argument("--from-samples"); p.add_argument("--audio")
p.add_argument("--label", default="S0"); p.add_argument("--source", default="", help="来源标注，如会议 slug")
p.set_defaults(fn=cmd_enroll)

p = sub.add_parser("identify", help="用声纹库标真人名")
p.add_argument("audio"); p.add_argument("--diar", required=True)
p.add_argument("--threshold", type=float, default=MATCH_THRESHOLD)
p.add_argument("--skip", default="", help="跳过的簇标签，逗号分隔，如 S2,S3")
p.add_argument("--no-map", action="store_true", help="忽略同目录的 speaker-map.json")
p.add_argument("--allow-ambiguous", action="store_true", help="前两名都过阈值时也出名字（默认不出）")
p.add_argument("--margin", type=float, default=0.12, help="第一名需领先第二名的幅度，默认 0.12")
p.set_defaults(fn=cmd_identify)

a = ap.parse_args()
a.fn(a)
